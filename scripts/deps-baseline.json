{
  "deps": {
    "vxl-phys-core": {
      "loom": {
        "why": "并发原语的模型测试（见 crates/vxl-phys-core/tests/loom_primitives.rs）。只在 cfg(loom) 下编译进去、只服务「loom (并发原语)」那一门，不进任何发布构建；它同时带来 tracing 系与 windows-sys 的传递闭包（见本文件 lock_packages）。",
        "version": "0.7.2"
      }
    },
    "vxl-phys-replay": {
      "xxhash-rust": {
        "why": "xxh3-128 规范化哈希的实现来源（§5：跨三编译器 + aarch64 必须逐位一致）。确定性契约要求「同一份哈希算法」，自研一份等于把契约建在自己的实现上，标准算法 + 钉版本更可审计。风险待盯：它的 SIMD 特性若随 target 变体，哈希值可能分叉——现有跨平台哈希门（determinism/hash-compare）是这条依赖的验收仪器。",
        "version": "0.8.18"
      }
    }
  },
