{
  "deps": {
    "<root>·workspace": {
      "wgpu": {
        "why": "GPU 档（SPEC §8 / M4）的统一入口：Vulkan/Metal/DX12/WebGPU 由它在运行时自选 ⇒ **不绑单一厂商**，与骨架硬性要求一致（另需 CPU 回退且结果一致）。它是**本仓最大的一次依赖扩张**（+101 个传递 crate、冷构建 debug ≈31 s、需 nightly 的 rust-gpu 是另一条工具链问题），因此理由必须写实：① 只给 `vxl-phys-gpu` 用（引擎其它 crate 不依赖它 ⇒ CPU 档的依赖面不变）；② 首个里程碑（密度+力相位）要拿它与 CPU 对拍（同数学/同场景/同哈希口径），**在拿到加速比与一致性读数之前不扩面**；③ 版本钉死（`27`），靠本基线的 ratchet 与 `cargo-deny` 双守。",
        "version": "27.0.1"
      }
    },
    "vxl-phys-core": {
      "loom": {
        "why": "并发原语的模型测试（见 crates/vxl-phys-core/tests/loom_primitives.rs）。只在 cfg(loom) 下编译进去、只服务「loom (并发原语)」那一门，不进任何发布构建；它同时带来 tracing 系与 windows-sys 的传递闭包（见本文件 lock_packages）。",
        "version": "0.7.2"
      }
    },
    "vxl-phys-gpu": {
      "wgpu": {
        "why": "GPU 档（SPEC §8 / M4）的统一入口：Vulkan/Metal/DX12/WebGPU 由它在运行时自选 ⇒ **不绑单一厂商**，与骨架硬性要求一致（另需 CPU 回退且结果一致）。它是**本仓最大的一次依赖扩张**（+101 个传递 crate、冷构建 debug ≈31 s、需 nightly 的 rust-gpu 是另一条工具链问题），因此理由必须写实：① 只给 `vxl-phys-gpu` 用（引擎其它 crate 不依赖它 ⇒ CPU 档的依赖面不变）；② 首个里程碑（密度+力相位）要拿它与 CPU 对拍（同数学/同场景/同哈希口径），**在拿到加速比与一致性读数之前不扩面**；③ 版本钉死（`27`），靠本基线的 ratchet 与 `cargo-deny` 双守。",
        "version": "27.0.1"
      }
    },
    "vxl-phys-replay": {
      "xxhash-rust": {
        "why": "xxh3-128 规范化哈希的实现来源（§5：跨三编译器 + aarch64 必须逐位一致）。确定性契约要求「同一份哈希算法」，自研一份等于把契约建在自己的实现上，标准算法 + 钉版本更可审计。风险待盯：它的 SIMD 特性若随 target 变体，哈希值可能分叉——现有跨平台哈希门（determinism/hash-compare）是这条依赖的验收仪器。",
        "version": "0.8.18"
      }
    }
  },
